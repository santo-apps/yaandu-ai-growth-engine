APP_NAME="Yaandu AI Growth Engine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_CHANNEL=stack
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=yaandu_growth
DB_USERNAME=postgres
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
FILESYSTEM_DISK=local
CRAWLER_PLAYWRIGHT_ENABLED=false
CRAWLER_SCREENSHOTS_ENABLED=true
CRAWLER_MAX_RESPONSE_BYTES=5000000
CRAWLER_REQUEST_TIMEOUT_SECONDS=15
CRAWLER_MAX_FETCH_ATTEMPTS=100
CRAWLER_MAX_LINKS_PER_PAGE=200
CRAWLER_MAX_DURATION_SECONDS=180
PRODUCTION_READINESS_TENANT_ID=
PRODUCTION_BACKUP_VERIFIED=false
PRODUCTION_MONITORING_CONFIGURED=false
SCHEDULE_HEARTBEAT_CONFIGURED=false
# Set true only after production storage controls are verified; local disk is runtime-probed by production:readiness.
PRODUCTION_STORAGE_RUNTIME_VERIFIED=false
PRODUCTION_TRUSTED_EDGE_VERIFIED=false
PRODUCTION_MAIL_ENABLED=false
# Optional path override for shared/containerized Playwright browser binaries.
PLAYWRIGHT_BROWSERS_PATH=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
OPENAI_API_KEY=
AI_DAILY_CALL_LIMIT=50
AI_DAILY_TOKEN_LIMIT=50000
PILOT_MAX_IMPORT_ROWS=25
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Local/test-only acceptance profile. These fake adapters must not be enabled
# in deployed environments; explicitly configure an approved real provider.
OUTBOUND_DEFAULT_PROVIDER=fake
OUTBOUND_ENABLED_PROVIDERS=fake
INBOUND_ENABLED_PROVIDERS=fake
SCHEDULING_ENABLED_PROVIDERS=fake
SALES_INTENT_CONFIDENCE_THRESHOLD=0.72
DISCOVERY_MAX_CANDIDATES_PER_RUN=100
DISCOVERY_MAX_CSV_ROWS=500
DISCOVERY_MAX_VERIFICATIONS_PER_RUN=100
DISCOVERY_MAX_PAGES_PER_DOMAIN=10
DISCOVERY_MAX_BROWSER_RENDERS_PER_RUN=0
DISCOVERY_MAX_AI_ANALYSES_PER_RUN=25
DISCOVERY_MAX_RUNTIME_SECONDS=600
# Local acceptance only: set both flags in the local server/worker process environment.
# Deterministic sources remain disabled by default and are rejected outside local/testing.
DISCOVERY_ALLOW_DETERMINISTIC=false
AI_DETERMINISTIC_ENABLED=false
AI_VISUAL_PROVIDER=openai
AI_VISUAL_MODEL=gpt-4.1-mini
AI_REASONING_PROVIDER=anthropic
AI_REASONING_MODEL=claude-3-7-sonnet-latest
AI_CLASSIFICATION_PROVIDER=gemini
AI_CLASSIFICATION_MODEL=gemini-2.5-flash
AI_SALES_PROVIDER=anthropic
AI_SALES_MODEL=claude-3-7-sonnet-latest
AI_CONTENT_PROVIDER=openai
AI_CONTENT_MODEL=gpt-4.1-mini
AI_EXTRACTION_PROVIDER=gemini
AI_EXTRACTION_MODEL=gemini-2.5-flash
