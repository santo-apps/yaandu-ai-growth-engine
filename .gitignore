/.phpunit.result.cache
/coverage/
/clover.xml

# Vue / Vite dependencies and generated build output
/node_modules/
/dist/
/public/build/
/public/hot
*.tsbuildinfo

# Local development data and acceptance artifacts
/yaandu_growth
/artifacts/local-acceptance/
/tests/Playwright/artifacts/
/tests/Playwright/screenshots/

# IDE, OS, editor and temporary files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.tmp
*.temp
